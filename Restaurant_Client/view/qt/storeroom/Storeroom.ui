           <widget class="QTabWidget" name="stockTab">
            <property name="styleSheet">
             <string notr="true">/* ===== QTabWidget :: PANE ===== */
QTabWidget::pane {
    border: 2px solid #383F51;
    border-radius: 4px;
    background-color: #DDDBF1;
    top: -1px;
}

/* ===== QTabBar :: TAB BASE ===== */
QTabBar::tab {
    background: #c2c0d4;
    color: #383F51;
    border: 2px solid #383F51;
    border-bottom: none;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    padding: 10px 24px;
    margin-right: 3px;
    font-weight: bold;
    font-size: 13px;
}

/* ===== HOVER ===== */
QTabBar::tab:hover {
    background: #DDDBF1;
    color: #2f3544;
}

/* ===== SELECTED ===== */
QTabBar::tab:selected {
    background: #3E527A;
    color: #DDDBF1;
    border: 2px solid #383F51;
    border-bottom: 2px solid #3E527A;
    margin-bottom: -2px;
}

/* ===== DISABLED ===== */
QTabBar::tab:disabled {
    background: #c2c0d4;
    color: #928072;
    border-color: #928072;
}

/* ===== SCROLL BUTTONS ===== */
QTabBar QToolButton {
    background: #c2c0d4;
    border: 1px solid #383F51;
    border-radius: 4px;
    color: #383F51;
}

QTabBar QToolButton:hover {
    background: #DDDBF1;
}

/* ===== ALIGNMENT ===== */
QTabWidget::tab-bar {
    left: 12px;
    alignment: left;
}</string>
